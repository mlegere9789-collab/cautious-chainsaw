    ],
    "army_chief_of_artillery": {
      "name": "Brigadier General William Pendleton",
      "fate": "Survived",
      "notes": "Pendleton exercised little tactical control. Corps chiefs -- especially Alexander -- made the real decisions."
    },
    "total_batteries": 45,
    "total_guns_approximately": 283,
    "alexander_cannonade_notes": {
      "event": "July 3 Confederate Cannonade -- approximately 1:00-3:00pm",
      "tick_range": [518, 542],
      "total_confederate_guns_engaged": 170,
      "alexander_message_1": "For God's sake come quick or we cannot support you -- ammunition nearly exhausted",
      "alexander_message_2": "I would not make the charge now -- but the order has been given and the troops are already moving",
      "notes": "Alexander's two messages to Pickett are among the most famous command communications of the battle. The cannonade consumed most of the Confederate ammunition reserve.",
      "placement_note": "During cannonade ticks all Confederate batteries on Seminary Ridge show Deployed Artillery disposition. Most complex artillery animation sequence in the entire battle."
    }
  },
