  "metadata": {
    "chunk": "013",
    "title": "Confederate Army -- Artillery, All Corps",
    "sources": [
      "Busey, John W. and Martin, David G. -- Regimental Strengths and Losses at Gettysburg (Longstreet House, 1994)",
      "OR Vol. 27, Parts I and II",
