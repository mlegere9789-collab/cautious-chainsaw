":"NPS-TREAT-2004"}],"method":"Centreline of the modern CSX Hanover Subdivision west of the borough (OSM ways listed), which was laid on the 1863 grade after 1863; the Bachelder/Warren sheet draws the grade as a straight line north of the Chambersburg Pike (check pending).","positional_error_m":40,"confidence":"Estimated","notes":"The modern rails and ties are not 1863; only the grade (cuts and embankments) existed. The west end of the 1863 grade is not established by the sources read; the line is drawn only to the edge of the map box.","osm_way_ids":[1078695840,1078695841,702107202,781044358,1212407684,1383353951,1383353952],"length_m_in_box":8814},"geometry":{"type":"LineString","coordinates":[[-77.23112,39.832089],[-77.231206,39.832088],[-77.231766,39.832082],[-77.233259,39.832076],[-77.233322,39.832076],[-77.233404,39.832077],[-77.233814,39.832085],[-77.234089,39.832094],[-77.234573,39.832119],[-77.2349,39.832135],[-77.235032,39.832146],[-77.235339,39.832172],[-77.235875,39.832226],[-77.236353,39.832299],[-77.236655,39.832361],[-77.236997,39.832439],[-77.237584,39.83257],[-77.238201,39.832731],[-77.238731,39.832881],[-77.239564,39.833174],[-77.240055,39.833359],[-77.240566,39.833567],[-77.240692,39.833621],[-77.241386,39.833915],[-77.241822,39.834109],[-77.242171,39.834278],[-77.242852,39.834631],[-77.243192,39.834819],[-77.243634,39.835068],[-77.243974,39.83526],[-77.245057,39.835874],[-77.245119,39.83591],[-77.245427,39.836085],[-77.246122,39.83647],[-77.246125,39.836472],[-77.246726,39.836812],[-77.248189,39.837627],[-77.248308,39.837699],[-77.249624,39.838451],[-77.250464,39.838926],[-77.250719,39.839068],[-77.251774,39.839666],[-77.255626,39.841837],[-77.255749,39.841907],[-77.256094,39.842103],[-77.257051,39.842641],[-77.258096,39.843228],[-77.25926,39.843859],[-77.259647,39.844058],[-77.260422,39.844454],[-77.261034,39.844766],[-77.261835,39.845165],[-77.262864,39.845683],[-77.26357,39.84603],[-77.264353,39.846388],[-77.264994,39.84669],[-77.265598,39.846