{
 "group": "POLISH",
 "description": "Extension part of POLISH, valid only when MON is in the build (it anchors on the Monuments runtime, as ANIM+mon.json does): the Monuments card and its jump button say the clock of the marker, not \"tick N of 675\".",
 "patches": [
  {
   "id": "POL-W20-mon-card-moment",
   "target": "js",
   "find": "\"Marker moment: July \"+dayOf(jt)+\", tick \"+jt+\" of 675.\"",
   "repl": "\"Marker moment: \"+(typeof GTBGT!==\"undefined\"&&GTBGT.f?GTBGT.f(jt,\"date\")+\", \"+GTBGT.f(jt,\"time\"):\"July \"+dayOf(jt)+\", moment \"+jt+\" of 675\")+\".\"",
   "expect": 1,
   "note": "MON card; anchors on MON's output, so POLISH must follow MON"
  },
  {
   "id": "POL-W21-mon-jump-aria",
   "target": "js",
   "find": "\"Jump to this moment: July \"+dayOf(jt)+\", tick \"+jt",
   "repl": "\"Jump to this moment: \"+(typeof GTBGT!==\"undefined\"&&GTBGT.f?GTBGT.f(jt,\"date\")+\", \"+GTBGT.f(jt,\"time\"):\"July \"+dayOf(jt)+\", moment \"+jt)",
   "expect": 1,
   "note": "MON jump button label"
  }
 ]
}
