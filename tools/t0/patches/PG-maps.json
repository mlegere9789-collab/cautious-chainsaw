      "target": "watch-together.html",
      "find": "<script src=\"https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js\"></script>",
      "repl": "<!-- PeerJS is not loaded with the page: Live Sync fetches it on demand (SRI-pinned) when someone clicks Host or Join. -->",
      "expect": 1,
      "note": "WP-T0-13 PeerJS leaves the head"
    },
    {
      "id": "maps:watch-together:peerjs-loader",
      "target": "watch-together.html",
      "find": "  if (typeof Peer === 'undefined') {\n    setSyncStatus('unavailable (couldn\\'t load the connection library)', 'error');\n    document.getElementById('host-btn').disabled = true;\n    document.getElementById('join-btn').disabled = true;\n  }",
      "repl": "  // Live Sync: PeerJS (about 90 KB) is not part of the page load.  It is fetched the first time someone clicks Host or Join, after\n  // the \"connecting...\" status has been painted, and pinned to the exact 1.5.4 file with SRI.\n  const PEERJS_SRC = 'https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js';\n  const PEERJS_SRI = 'sha384-nlUQ8ZqCbvStErob+biJNzSgltf6urV3VGqhfIfzhmg9RXmpeRm76ELw0pYnKlTR';\n  let peerLibPromise = null;\n  function loadPeerJs() {\n    if (typeof Peer !== 'undefined') return Promise.resolve();\n    if (!peerLibPromise) {\n      peerLibPromise = new Promise((resolve, reject) => {\n        const s = document.createElement('script');\n        s.src = PEERJS_SRC; s.integrity = PEERJS_SRI; s.crossOrigin = 'anonymous';\n        s.onload = () => (typeof Peer !== 'undefined' ? resolve() : reject(new Error('PeerJS loaded but did not define Peer')));\n        s.onerror = () => reject(new Error('PeerJS could not be loaded'));\n        document.head.appendChild(s);\n      }).catch((err) => { peerLibPromise = null; throw err; });\n    }\n    return peerLibPromise;\n  }\n  // `start` runs once PeerJS is available; the caller has already set the status text, which gets a frame to paint first.\n  function withPeerJs(start) {\n    requestAnimationFrame(() => setTimeout(() => {\n      loadPeerJs().then(start, () => setSyncStatus(\"unavailable (couldn't load the connection library)\", 'error'));\n    }, 0));\n  }",
      "expect": 1,
      "note": "WP-T0-13 on-demand loader replaces the load-time availability check"
    },
    {
      "id": "maps:watch-together:host-open",
      "target": "watch-together.html",
      "find": "  document.getElementById('host-btn').addEventListener('click', () => {\n    if (typeof Peer === 'undefined') return;\n    if (peer) peer.destroy();",
      "repl": "  document.getElementById('host-btn').addEventListener('click', () => {\n    setSyncStatus('connecting…', 'connecting');\n    withPeerJs(startHost);\n  });\n  function startHost() {\n    if (peer) peer.destroy();",
      "expect": 1,
      "note": "WP-T0-13 Host: status first, then load PeerJS, then startHost"
    },
