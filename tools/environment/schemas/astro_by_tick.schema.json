{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gettysburg.local/schemas/astro_by_tick.schema.json",
  "title": "Sun and moon at each of the 675 ticks (candidate clock)",
  "description": "Computed. Depends on the UNSIGNED time model only through tools/environment/tickclock.mjs; the anchors used are embedded with a SHA-256 of the source document so staleness is detected.",
  "type": "object",
  "required": ["schema_version", "dataset", "title", "status", "badge", "method", "cites", "time_model", "conventions", "cross_check_summary", "events", "columns", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset": { "const": "astro_by_tick" },
    "status": { "type": "string", "minLength": 40 },
    "badge": { "const": "Computed" },
    "method": { "const": "astronomy-engine" },
    "cites": { "type": "array", "minItems": 2 },
    "time_model": {
      "type": "object",
      "required": ["source", "version", "release", "sha256", "tick_max", "function", "anchors", "anchors_needing_historian", "note"],
      "properties": {
        "release": { "const": "candidate" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tick_max": { "const": 675 },
        "anchors": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["tick", "t", "min"], "properties": { "tick": { "type": "integer", "minimum": 1, "maximum": 675 }, "t": { "type": "string", "pattern": "^1863-07-0[1-3]T[0-2][0-9]:[0-5][0-9]$" }, "min": { "type": "integer" } } } },
        "note": { "type": "string", "pattern": "CANDIDATE" }
      }
    },
    "conventions": { "type": "object", "required": ["clock", "altitude", "light", "moon_up", "moon_illum_pct", "precision"] },
    "cross_check_summary": { "type": "object", "required": ["ticks", "method_b_vs_a_max_abs_sun_alt_deg", "method_b_vs_a_max_abs_moon_alt_deg", "method_b_vs_a_max_abs_az_deg", "method_b_vs_a_max_abs_illum_pct"] },
    "events": { "type": "array", "minItems": 20, "items": { "type": "object", "required": ["date", "event", "lmt", "lmt_hms", "lmt_min", "tick"], "properties": { "date": { "enum": ["1863-07-01", "1863-07-02", "1863-07-03"] }, "event": { "enum": ["civil_dawn", "sunrise", "solar_transit", "sunset", "civil_dusk", "nautical_dawn", "nautical_dusk", "moonrise", "moon_transit", "moonset"] }, "lmt_min": { "type": "number" }, "tick": { "type": ["number", "null"], "minimum": 1, "maximum": 675 } } } },
    "columns": { "const": ["tick", "lmt_min", "lmt", "sun_alt_deg", "sun_az_deg", "moon_alt_deg", "moon_az_deg", "moon_illum_pct", "light", "moon_up"] },
    "rows": {
      "type": "array", "minItems": 675, "maxItems": 675,
      "items": {
        "type": "array", "minItems": 10, "maxItems": 10,
        "prefixItems": [
          { "type": "integer", "minimum": 1, "maximum": 675 },
          { "type": "number" },
          { "type": "string", "pattern": "^07-0[1-3] [0-2][0-9]:[0-5][0-9]$" },
          { "type": "number", "minimum": -90, "maximum": 90 },
          { "type": "number", "minimum": 0, "maximum": 360 },
          { "type": "number", "minimum": -90, "maximum": 90 },
          { "type": "number", "minimum": 0, "maximum": 360 },
          { "type": "number", "minimum": 0, "maximum": 100 },
          { "enum": ["day", "civil_twilight", "nautical_twilight", "astronomical_twilight", "night"] },
          { "enum": [0, 1] }
        ]
      }
    }
  }
}
