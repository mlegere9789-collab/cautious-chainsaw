{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gettysburg.local/schemas/visual_readings.schema.json",
  "title": "Page-image readings (the second extraction method)",
  "description": "What the Claude model read when it looked at a page image, next to the OCR text. Tables are re-added by the validator.",
  "type": "object",
  "required": ["schema_version", "dataset", "note", "readings"],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset": { "enum": ["ledger_visual_readings", "environment_visual_readings"] },
    "note": { "type": "string", "minLength": 20 },
    "readings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reading" } }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["cache", "sha256", "bytes"],
      "properties": { "ia": { "type": "string" }, "reader_n": { "type": "integer" }, "scan_leaf": { "type": "integer" }, "cache": { "type": "string" }, "url": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "bytes": { "type": "integer", "minimum": 1000 }, "retrieved": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "quality": { "type": "string" } }
    },
    "table": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "title": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array" } },
        "total_row": { "type": ["array", "null"] },
        "figure_map": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "figure_row": { "type": "object" }
      }
    },
    "reading": {
      "type": "object",
      "required": ["id", "image"],
      "properties": {
        "id": { "type": "string", "pattern": "^VR-[A-Za-z0-9-]+$" },
        "source": { "type": "string" },
        "witness": { "type": "string" },
        "printed_page": { "type": "integer" },
        "header_read": { "type": ["string", "null"] },
        "image": { "$ref": "#/$defs/image" },
        "lines": { "type": "array", "items": { "type": "string" } },
        "numbers": { "type": "array", "items": { "type": "number" } },
        "times": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2} [ap]\\.m\\.$" } },
        "table": { "$ref": "#/$defs/table" },
        "notes_read": { "type": "array" },
        "ocr_note": { "type": "string" },
        "cells": { "type": "array", "items": { "type": "object", "required": ["id", "date", "col", "read", "legibility"], "properties": { "read": { "type": "string" }, "legibility": { "enum": ["clear", "degraded"] } } } },
        "texts": { "type": "array", "items": { "type": "object", "required": ["id", "read", "legibility"], "properties": { "legibility": { "enum": ["clear", "degraded"] } } } }
      }
    }
  }
}
