{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gettysburg.local/schemas/conflict_ledger.schema.json",
  "title": "Where the Sources Disagree: conflict ledger",
  "description": "One row per question on which published sources disagree. Every value keeps its source, edition, page, tier and what it counts. Values are never averaged and never silently chosen: shown_first is a display order with a written rule.",
  "type": "object",
  "required": ["schema_version", "dataset", "title", "status", "rules", "sources", "quotes", "rows", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset": { "const": "conflict_ledger" },
    "title": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "minLength": 20 },
    "rules": { "type": "object", "required": ["no_averaging", "shown_first", "status_ladder", "tiers", "verification", "link_out_only"] },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "quotes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/quote" } },
    "rows": { "type": "array", "minItems": 18, "items": { "$ref": "#/$defs/row" } },
    "summary": { "type": "object", "required": ["rows", "values", "quotes", "figures"], "properties": { "rows": { "type": "integer", "minimum": 18 }, "values": { "type": "integer" }, "quotes": { "type": "integer" }, "figures": { "type": "integer" } } }
  },
  "$defs": {
    "tier": { "enum": ["A1", "A2", "B", "S"] },
    "source": {
      "type": "object",
      "required": ["id", "tier", "title", "rights", "short"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "tier": { "$ref": "#/$defs/tier" },
        "title": { "type": "string", "minLength": 5 },
        "imprint": { "type": "string" },
        "imprint_year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
        "rights": { "type": "string", "minLength": 5 },
        "ia": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" },
        "cache": { "type": "string" },
        "short": { "type": "string" }
      }
    },
    "witness": {
      "type": "object",
      "required": ["witness", "ia", "kind", "leaf", "printed_page"],
      "properties": { "witness": { "type": "string" }, "ia": { "type": "string" }, "kind": { "enum": ["djvu", "abbyy"] }, "leaf": { "type": "integer", "minimum": 0 }, "printed_page": { "type": "integer", "minimum": 1 }, "reader_n": { "type": ["integer", "null"] } }
    },
    "textOrFragments": { "oneOf": [{ "type": "string", "minLength": 3 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }] },
    "quote": {
      "type": "object",
      "required": ["id", "type", "source", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "type": { "enum": ["ocr", "image", "web", "site", "ref"] },
        "source": { "type": "string" },
        "text": { "$ref": "#/$defs/textOrFragments" },
        "who": { "type": "string" },
        "printed_page": { "type": ["integer", "null"] },
        "witnesses": { "type": "array", "items": { "$ref": "#/$defs/witness" } },
        "reading": { "type": "string" },
        "image_confirm": { "type": "string" },
        "ocr_check": { "type": "object", "required": ["expect_found", "known_ocr_variants"], "properties": { "expect_found": { "type": "array", "items": { "type": "string" } }, "known_ocr_variants": { "type": "array", "items": { "type": "object", "required": ["printed", "ocr"], "properties": { "printed": { "type": "string" }, "ocr": { "type": "string" } } } } } },
        "sum_check": { "type": "object", "required": ["numbers", "total"], "properties": { "numbers": { "type": "array", "items": { "type": "number" } }, "total": { "type": "number" } } },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "file": { "type": "string" }, "path": { "type": "string" }, "value": { "type": "number" },
        "observation": { "type": "string" }, "witness": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "ocr" } } }, "then": { "required": ["witnesses", "printed_page"], "properties": { "witnesses": { "minItems": 1 } } } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["reading", "ocr_check", "printed_page"] } },
        { "if": { "properties": { "type": { "const": "site" } } }, "then": { "required": ["file", "path", "value"] } },
        { "if": { "properties": { "type": { "const": "ref" } } }, "then": { "required": ["observation", "witness", "value"] } }
      ]
    },
    "value": {
      "type": "object",
      "required": ["id", "authority", "source", "edition", "page", "tier", "quote", "figures", "what_is_counted", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^v[0-9]+$" },
        "authority": { "type": "string", "minLength": 5 },
        "source": { "type": "string" },
        "edition": { "type": "string", "minLength": 3 },
        "page": { "type": ["integer", "null"] },
        "tier": { "$ref": "#/$defs/tier" },
        "quote": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "figures": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["number", "string"] } },
        "printed": { "type": "object", "additionalProperties": { "type": "string" } },
        "derived": { "type": "object", "additionalProperties": { "type": "number" } },
        "derivation": { "type": "string" },
        "approximate": { "type": "boolean" }, "estimate": { "type": "boolean" }, "range": { "type": "boolean" }, "clock": { "type": "boolean" }, "contested": { "type": "boolean" }, "unverified_origin": { "type": "boolean" },
        "copies": { "type": "string" },
        "what_is_counted": { "type": "string", "minLength": 15 },
        "checks": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["sum", "diff", "table", "percent", "approx", "sum_quote"] } } } },
        "verification": { "type": "object", "required": ["figures", "level"], "properties": { "level": { "enum": ["two_extraction_methods", "one_extraction_method_plus_checksum", "one_extraction_method"] }, "figures": { "type": "object" } } }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "kind", "title", "question", "values", "shown_first", "status", "reason_for_difference", "what_would_settle", "review"],
      "properties": {
        "id": { "type": "string", "pattern": "^WSD-[0-9]{2}$" },
        "pitch_row": { "type": ["integer", "null"] },
        "kind": { "enum": ["casualties", "strength", "burials", "unit-loss", "clock-time", "count", "weather", "description"] },
        "title": { "type": "string", "minLength": 8 },
        "question": { "type": "string", "minLength": 8 },
        "values": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/value" } },
        "shown_first": { "type": "object", "required": ["value", "rule"], "properties": { "value": { "type": ["string", "null"] }, "rule": { "type": "string", "minLength": 20 } } },
        "status": { "enum": ["adopted with reason", "open", "unresolvable"] },
        "reason_for_difference": { "type": "string", "minLength": 20 },
        "what_would_settle": { "type": "string", "minLength": 15 },
        "review": { "type": "array", "items": { "type": "object", "required": ["needs", "what"], "properties": { "needs": { "enum": ["historian", "owner", "counsel"] }, "what": { "type": "string" } } } },
        "held_back": { "type": "array", "items": { "type": "object", "required": ["claim", "reason"] } },
        "reason_quotes": { "type": "array", "items": { "type": "string" } },
        "by_unit": { "type": "object" },
        "ref": { "type": "object" }
      },
      "not": { "anyOf": [{ "required": ["mean"] }, { "required": ["average"] }, { "required": ["median"] }, { "required": ["consensus"] }, { "required": ["best_estimate"] }, { "required": ["adopted_value"] }] }
    }
  }
}
